#[derive(Debug,Clone,Copy)]
struct P4 {
    x:i32,
    y:i32,
    z:i32,
    t:i32,
    constellation:usize,
}
impl P4 {
    fn dist4(self, p:&P4)->usize
    {
        return ((self.x-p.x).abs() + (self.y-p.y).abs() + (self.z-p.z).abs() +(self.t-p.t).abs()) as usize;
    }
    fn _order(self)->usize
    {
        let mut x = (self.x+1000) as usize;
        let mut y = (self.y+1000) as usize;
        let mut z = (self.z+1000) as usize;
        let mut t = (self.t+1000) as usize;
        let mut bits:usize = 0;
        let mut shift = 0;
        for _b in 0..10 {
            bits |= (x & 1) << shift; shift += 1; x >>= 1;
            bits |= (y & 1) << shift; shift += 1; y >>= 1;
            bits |= (z & 1) << shift; shift += 1; z >>= 1;
            bits |= (t & 1) << shift; shift += 1; t >>= 1;
        }
        return bits;
    }
}

fn _process(inp:String) -> usize
{
//    let mut lines:Vec<String> = inp.split("\n").map(|s| s.to_string()).collect();
    let p = parser!(lines(x:i32 "," y:i32 "," z:i32 "," t:i32 => P4{x:x,y:y,z:z,t:t,constellation:usize::MAX}));
    let mut points = p.parse(&inp).unwrap();
    let mut points_to_place_in_constellation = points.len();
    let mut constellation:usize = 0;
    let mut constellations:Vec<Vec<P4>> = vec![];
    while points_to_place_in_constellation > 0 {
        for i in 0..points.len() {
            if points[i].constellation == 0 {
                constellation += 1;
//                let mut con:Vec<P4> = vec![];
                points[i].constellation = constellation;
                constellations.push(vec![]);
                constellations[constellation-1].push(points[i]);
                points_to_place_in_constellation -= 1;
//                println!("{} constallations found, {} points remaining", constellation, points_to_place_in_constellation);

                'outer: loop {
//                    let mut found = false;
                    for j in i+1..points.len() {
                        if points[j].constellation == 0 {
                            let conlen = constellations[constellation-1].len();
                            for k in 0..conlen {
                                if points[j].dist4(&constellations[constellation-1][k]) <= 3 {
                                    points[j].constellation = constellation;
                                    constellations[constellation-1].push(points[j].clone());
                                    points_to_place_in_constellation -= 1;
//                                    found = true;
                                    continue 'outer;
                                }
                            }
                        }
                    }
//                    constellations.push(con);
//                    if !found {break}
                    break;
                }
            }
        }
        // Filter the points:
        let mut filtered_points = vec![];
        for p in points.iter() {
            if p.constellation == 0 {
                filtered_points.push(p.clone());
            }
        }
        points = filtered_points;

    }

    return constellations.len();
}


fn flatten(points:&mut [P4], idx:usize)->usize
{
    let mut i = points[idx].constellation;
    let mut parent = idx;
    if i != idx {
        let mut ip = points[i].constellation;
        while ip != i {
            i = ip;
            ip = points[i].constellation;
        }
        parent = ip;
        i = idx;
        while i != parent {
            ip = points[i].constellation;
            points[i].constellation = parent;
            i = ip;
        }
    }
    return parent;
}

fn _flatten1(points:&mut Vec<P4>, idx:usize)->usize
{
    let mut i = points[idx].constellation;
    let mut parent = i;
    if i != idx {
        let mut ip = i; 
        let mut ipp = points[i].constellation;
        i = idx;
        while ipp != i {
            points[i].constellation = ipp;
            i = ip;
            ip = ipp;
            ipp = points[ipp].constellation;
        }
        parent = i;
    }
    return parent;
}

fn process_djs(inp:String) -> usize
{
//    let mut lines:Vec<String> = inp.split("\n").map(|s| s.to_string()).collect();
    let p = parser!(lines(x:i32 "," y:i32 "," z:i32 "," t:i32 => P4{x,y,z,t,constellation:usize::MAX}));
    let mut points = p.parse(&inp).unwrap();
    let mut sets = 0;
    for i in 0..points.len() {
        let mut parent = i;
        sets += 1;
        if points[i].constellation != usize::MAX {
            parent = flatten(&mut points,i);
            sets -= 1;
        }
        points[i].constellation = parent;

        for j in i+1..points.len() {
            if /* i != j && */ points[i].dist4(&points[j]) <= 3 {
                if points[j].constellation == usize::MAX {
                    points[j].constellation = parent;
                }
                else { // Merge two sets if they are disjunct
                    let jparent = flatten(&mut points, j);
                    if jparent != parent { // Two different sets to be merged, pick the lowest #!
                        if jparent < parent {
                            points[parent].constellation = jparent;
                            parent = flatten(&mut points, i);
                            sets -= 1;
                        }
                        else { //if jparent > parent {
                            points[jparent].constellation = parent;
                            flatten(&mut points, j);
                            sets -= 1;
                        }
                    }
                }
            }
        }
    }
    return sets;
}

fn _process_bit_order(inp:String) -> usize
{
//    let mut lines:Vec<String> = inp.split("\n").map(|s| s.to_string()).collect();
    let p = parser!(lines(x:i32 "," y:i32 "," z:i32 "," t:i32 => P4{x:x,y:y,z:z,t:t,constellation:0}));
    let mut points = p.parse(&inp).unwrap();
//    points.sort_by(|a,b| a.order().cmp(&b.order()));
    points.sort_by(|a,b| a.x.cmp(&b.x));
    let mut points_to_place_in_constellation = points.len();
    let mut constellation:usize = 0;
    let mut constellations:Vec<Vec<P4>> = vec![];
    while points_to_place_in_constellation > 0 {
        for i in 0..points.len() {
            if points[i].constellation == 0 {
                constellation += 1;
//                let mut con:Vec<P4> = vec![];
                points[i].constellation = constellation;
                constellations.push(vec![]);
                constellations[constellation-1].push(points[i].clone());
                points_to_place_in_constellation -= 1;
//                println!("{} constallations found, {} points remaining", constellation, points_to_place_in_constellation);

                'outer: loop {
//                    let mut found = false;
                    for j in i+1..points.len() {
                        if points[j].constellation == 0 {
                            let conlen = constellations[constellation-1].len();
                            for k in 0..conlen {
                                let dist = points[j].dist4(&constellations[constellation-1][k]);
                                if dist <= 3 {
                                    points[j].constellation = constellation;
                                    constellations[constellation-1].push(points[j].clone());
                                    points_to_place_in_constellation -= 1;
//                                    found = true;
                                    continue 'outer;
                                }
//                                else {
//                                    println!("{dist} to const {constellation} with {} members", constellations[constellation-1].len());
//                                }
                            }
                        }
                    }
//                    constellations.push(con);
//                    if !found {break}
                    break;
                }
            }
        }
        // Filter the points:
        let mut filtered_points = vec![];
        for p in points.iter() {
            if p.constellation == 0 {
                filtered_points.push(p.clone());
            }
        }
        points = filtered_points;

    }

    return constellations.len();
}
  
    

fn main() {
    assert!(process_djs(
"-1,2,2,0
0,0,2,-2
0,0,0,-2
-1,2,0,0
-2,-2,-2,2
3,0,2,-1
-1,3,2,2
-1,0,-1,0
0,2,1,-2
3,0,0,0".to_owned()) == 4);

    let fname = "input.txt"; // instead of args[1]
    let mut input = fs::read_to_string(fname).expect("Error readin input file");
    if input.as_bytes()[input.as_bytes().len()-1] == '\n' as u8 {input.pop();}

//    let sets = process_djs(input.clone()); println!("Found {sets} sets");

    let mut devtime = DevTime::new_simple();

    let bench_result = run_benchmark(25, |_| { process_djs(input.clone()); }); bench_result.print_stats();

    devtime.start();
    let part1 = process_djs(input.clone());
    devtime.stop();

    println!("Part1 = {part1}");
    println!("Total time {} us",devtime.time_in_micros().unwrap());
}